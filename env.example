# Morning Quiz Bot - Environment Variables Example
# Скопируйте этот файл в .env и заполните вашими значениями

# Обязательные переменные
BOT_TOKEN=your_telegram_bot_token_here

# Опциональные переменные
LOG_LEVEL=INFO
# Доступные уровни: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Режим работы бота
MODE=production
# Доступные режимы: production, testing
# production: продакшен режим (6 часов очистка, PRODUCTION_MODE=true)
# testing: тестовый режим (1 минута очистка, DEBUG_MODE=true)

# Настройки для продакшена (опционально)
# SENTRY_DSN=your_sentry_dsn_here

# OpenRouter API для генерации фактов от Совы Филиныча (опционально)
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# Получите ключ на https://openrouter.ai
# Используется модель qwen/qwen3-max для генерации занимательных фактов

# Proxy только для Telegram Bot API этого процесса (опционально)
# Поддерживаются http://, https:// и socks5://
# Примеры:
# TELEGRAM_PROXY_URL=http://127.0.0.1:3128
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080

# PostgreSQL (пока STORAGE_BACKEND=json, бот продолжает использовать текущие файлы)
STORAGE_BACKEND=json
DATABASE_URL=postgresql+asyncpg://morning_quiz:change-me@postgres:5432/morning_quiz
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10
DATABASE_ECHO=false

# Только для локального Docker Compose. В production передавайте через secrets.
POSTGRES_DB=morning_quiz
POSTGRES_USER=morning_quiz
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Отдельный ключ локальной админки: случайные 32+ символа, не BOT_TOKEN.
# Пустой/короткий ключ закрывает доступ (503), режима обхода входа нет.
ADMIN_ACCESS_TOKEN=
# Только имена хостов, без схемы/порта. За пределами loopback обязателен HTTPS.
ADMIN_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Shared binary photo directory for the bot and PostgreSQL admin (default: data/images).
# Local preview overrides this with .local/preview/images; never point preview at production.
PHOTO_IMAGES_DIR=

# Separate Mini App process; web.mini_app deliberately does NOT load .env itself.
# Set these in that process only, using a restricted DB role before publication.
MINI_APP_DATABASE_URL=
# Same bot identity used to sign Telegram initData; never an admin access key.
MINI_APP_BOT_TOKEN=
# Exact HTTPS origin, no trailing slash. Production domain is not selected yet.
MINI_APP_ORIGIN=
# 1 only for synthetic loopback development; group access then fails closed.
MINI_APP_OFFLINE=0
# Optional future public user UI, NOT the local admin URL. Empty keeps chat unchanged.
MINI_APP_URL=
# Separate editor-AI credentials; existing bot OPENROUTER_API_KEY is not reused.
MQB_ADMIN_AI_ENABLED=0
MQB_ADMIN_AI_ANTHROPIC_KEY=
MQB_ADMIN_AI_ANTHROPIC_MODEL=
MQB_ADMIN_AI_OPENROUTER_KEY=
MQB_ADMIN_AI_OPENROUTER_MODEL=
MQB_ADMIN_AI_PUTER_KEY=
MQB_ADMIN_AI_PUTER_MODEL=
