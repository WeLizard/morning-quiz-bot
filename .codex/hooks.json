{
  "description": "Read-only Morning Quiz context and advisory static checks. No deployment or app startup.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "commandWindows": "python -c \"import pathlib,runpy,subprocess; root=subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip(); runpy.run_path(str(pathlib.Path(root)/'scripts'/'codex_project_hook.py'),run_name='__main__')\"",
            "statusMessage": "Checking Morning Quiz project rules",
            "timeout": 30,
            "type": "command",
            "command": "python3 -c \"import pathlib,runpy,subprocess; root=subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip(); runpy.run_path(str(pathlib.Path(root)/'scripts'/'codex_project_hook.py'),run_name='__main__')\"",
            "additionalContextLimit": 1500
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "commandWindows": "python -c \"import pathlib,runpy,subprocess; root=subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip(); runpy.run_path(str(pathlib.Path(root)/'scripts'/'codex_project_hook.py'),run_name='__main__')\"",
            "statusMessage": "Checking Morning Quiz project rules",
            "timeout": 30,
            "type": "command",
            "command": "python3 -c \"import pathlib,runpy,subprocess; root=subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip(); runpy.run_path(str(pathlib.Path(root)/'scripts'/'codex_project_hook.py'),run_name='__main__')\""
          }
        ]
      }
    ]
  }
}
